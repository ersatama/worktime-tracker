# Для запуска вне Docker (php artisan serve + npm run dev) против MySQL и Redis
# из docker compose: они проброшены на 127.0.0.1:33060 и 127.0.0.1:63790.
# В Docker этот файл не нужен — окружение задано в docker-compose.yml.

APP_NAME="Учёт времени"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33060
DB_DATABASE=worktime
DB_USERNAME=worktime
DB_PASSWORD=worktime

# Нужно расширение phpredis. Без него: CACHE_STORE=database и SESSION_DRIVER=database.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=63790

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

INERTIA_SSR_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
